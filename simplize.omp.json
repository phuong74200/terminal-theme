{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "green",
          "properties": {
            "user_info": false,
            "display_host": true
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "blue",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "green",
          "properties": {
            "display_status": true,
            "display_stash_count": false,
            "display_upstream_icon": false,
            "prefix": " [",
            "suffix": "]",
            "status_colors_enabled": true,
            "status_color_staged": "red",
            "status_color_unstaged": "yellow",
            "status_color_untracked": "yellow",
            "status_color_default": "green"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "foreground": "cyan",
          "properties": {
            "template": "{{ .HEAD }}{{ if .Working.Changed }}*{{ end }}",
            "prefix": "► ",
            "suffix": " ◄"
          }
        }
      ]
    }
  ]
}
